# Salin file ini menjadi .env lalu isi nilainya.
# Di Vercel: Project Settings -> Environment Variables (isi variabel Supabase & opsional Cloudinary di bawah).

# Supabase: Project Settings -> API (atau tombol "Connect")
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudinary (Opsional — untuk unggah foto berita & dokumentasi langsung dari dashboard Admin)
# Buat Upload Preset bertipe "Unsigned" di Cloudinary Dashboard -> Settings -> Upload
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Hanya untuk mode localhost tanpa Supabase (npm run dev)
VITE_API_URL=http://localhost:5001/api
